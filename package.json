{
  "name": "agent-qc",
  "version": "0.1.0",
  "description": "Deterministic quality gates for agentic development workflows.",
  "type": "module",
  "bin": {
    "agent-qc": "./src/index.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run check && npm run package:smoke"
  },
  "keywords": [
    "agents",
    "quality-gate",
    "github",
    "cli"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/agent-qc.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/agent-qc/issues"
  },
  "homepage": "https://github.com/rogerchappel/agent-qc#readme"
}
