{
  "name": "agent-qc",
  "version": "0.1.0",
  "description": "Deterministic quality gates for agentic development workflows.",
  "type": "module",
  "bin": {
    "agent-qc": "src/index.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "AGENTS.md",
    "CODE_OF_CONDUCT.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/agent-qc.git"
  },
  "scripts": {
    "check": "node --check src/index.js",
    "lint": "node --check src/index.js",
    "test": "node --test",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "node scripts/pack-smoke.mjs",
    "release:readiness": "node scripts/validate-release-readiness.mjs",
    "release:check": "npm run release:readiness && npm test && npm run check && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agents",
    "quality-gate",
    "github",
    "cli"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/agent-qc/issues"
  },
  "homepage": "https://github.com/rogerchappel/agent-qc#readme"
}
